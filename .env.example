# Copy to .env for local development: cp .env.example .env

# ---------------------------------------------------------------------------
# Which database to use: "local" or "hosted".
# One switch, followed by the app, migrations and Prisma Studio alike.
# Check which one is selected at any time with: npm run db:which
# ---------------------------------------------------------------------------
DB_TARGET=local

# Local Postgres, as separate parts. The password is escaped for you, so paste it
# exactly as it is — symbols like @ # / : ? % need no encoding here.
DB_USER="postgres"
DB_PASSWORD="postgres"

# Optional — these are the defaults, uncomment only to change one.
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="docket"
# DB_SCHEMA="public"

# Alternative to the parts above: the whole connection string in one line. Only used
# when DB_USER is unset — if both are present, the parts win.
# DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/docket?schema=public"

# Render dashboard → Postgres → Connect → External Database URL
DATABASE_URL_HOSTED=""

# On Render, DATABASE_URL is injected and DB_TARGET is unset; the app falls back
# to DATABASE_URL, so no changes are needed there.
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth — generate a long random secret for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"

# The first user, created on startup only when no users exist yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"

# ---------------------------------------------------------------------------
# Startup
# ---------------------------------------------------------------------------
# Apply pending migrations automatically when the app starts. Set false to skip.
AUTO_MIGRATE=true

PORT=3000
